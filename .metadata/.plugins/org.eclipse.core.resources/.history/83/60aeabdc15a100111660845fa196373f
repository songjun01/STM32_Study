#include "FND_controller.h"

uint8_t _LED_0F[29];

static SPI_HandleTypeDef * mhspi;

// 세그먼트 데이터 값 초기화
void init_FND(SPI_HandleTypeDef * hspi)
{
	mhspi = hspi;

	_LED_0F[0] = 0xC0;	// 0
	_LED_0F[1] = 0xF9;	// 1
	_LED_0F[2] = 0xA4;	// 2
	_LED_0F[3] = 0xB0;	// 3
	_LED_0F[4] = 0x99;	// 4
	_LED_0F[5] = 0x92;	// 5
	_LED_0F[6] = 0x82;	// 6
	_LED_0F[7] = 0xF8;	// 7
	_LED_0F[8] = 0x80;	// 8
	_LED_0F[9] = 0x90;	// 9
	_LED_0F[10] = 0x88;	// A
	_LED_0F[11] = 0x83;	// b
	_LED_0F[12] = 0xC6;	// C
	_LED_0F[13] = 0xA1;	// d
	_LED_0F[14] = 0x86;	// E
	_LED_0F[15] = 0x8E;	// F
	_LED_0F[16] = 0xC2;	// G
	_LED_0F[17] = 0x89;	// H
	_LED_0F[18] = 0xF9;	// I
	_LED_0F[19] = 0xF1;	// J
	_LED_0F[20] = 0xC7;	// L
	_LED_0F[21] = 0xA9;	// n
	_LED_0F[22] = 0xC0;	// O
	_LED_0F[23] = 0x8C; // P
	_LED_0F[24] = 0x98;	// q
	_LED_0F[25] = 0x92; // S
	_LED_0F[26] = 0xC1; // U
	_LED_0F[27] = 0x91; // Y
	_LED_0F[28] = 0xFE; // Hight -

}


// 8비트 데이터를 MSB → LSB 순서로 직렬 전송
void send(uint8_t x)
{
	HAL_SPI_Transmit(mhspi, &x, 1, 1);
}


// 데이터 x -> send(x) -> 포트 정보 -> send(port) -> RCLK (LOW → HIGH) -> 실제 출력 반영
void send_port(uint8_t x, uint8_t port)
{
	// 먼저 출력할 데이터 x를 8비트 직렬 데이터로 전송
	send(x);
	// 다음으로 데이터를 출력할 FND 포트 정보를 전송
	send(port);

	// RCLK(Latch/Storage Clock) 신호 생성
	// 앞에서 전송한 데이터와 포트 정보를 출력 레지스터에 반영
	//
	// LOW → HIGH 전환을 통해 TM74HC595의
	// Shift Register에 저장된 데이터를 출력으로 전달
	HAL_GPIO_WritePin(FND_RCLK_GPIO_Port, FND_RCLK_Pin, 0);
	HAL_GPIO_WritePin(FND_RCLK_GPIO_Port, FND_RCLK_Pin, 1);
}


void digit4(int n, int replay, uint8_t showZero)
{
	int n1, n2, n3, n4;

	n1 = (int) n % 10;
	n2 = (int) (n % 100) / 10;
	n3 = (int) (n % 1000) / 100;
	n4 = (int) (n % 10000) / 1000;

	for (int i = 0; i <= replay; i++)
	{
		// 1의 자리
		send_port(_LED_0F[n1], 0b0001);

		// 10의 자리
		if (showZero || n > 9)
			send_port(_LED_0F[n2], 0b0010);

		// 100의 자리
		if (showZero || n > 99)
			send_port(_LED_0F[n3], 0b0100);

		// 1000의 자리
		if (showZero || n > 999)
			send_port(_LED_0F[n4], 0b1000);
	}
}


void digit4_temper(int n, int replay)
{
	int n1, n2, n3, n4;

	n1 = (int) n % 10;
	n2 = (int) (n % 100) / 10;
	n3 = (int) (n % 1000) / 100;
	n4 = (int) (n % 10000) / 1000;

	for (int i = 0; i <= replay; i++)
	{
		// 1의 자리
		send_port(_LED_0F[n1], 0b0001);

		// 10의 자리
		send_port(_LED_0F[n2] & 0x7F, 0b0010);

		// 100의 자리
		if (n > 99)
			send_port(_LED_0F[n3], 0b0100);

		// 1000의 자리
		if (n > 999)
			send_port(_LED_0F[n4], 0b1000);
	}
}


void digit4_replay(int n, int replay)
{
	digit4(n, replay, 0);
}


void digit4_n(int n)
{
	digit4(n, 0, 0);
}


void digit4ShowZero_replay(int n, int replay)
{
	digit4(n, replay, 1);
}


void digit4ShowZero_n(int n)
{
	digit4(n, 0, 1);
}


void digit2(int n, int port, int replay)
{
	int n1, n2;
	n1 = (int) n % 10;
	n2 = (int) ((n % 100) - n1) / 10;

	for (int i = 0; i<= replay; i++)
	{
		send_port(_LED_0F[n1], port);
		send_port(_LED_0F[n2], port << 1);
	}
}


void digit2_port(int n, int port)
{
	digit2(n, port, 0);
}



