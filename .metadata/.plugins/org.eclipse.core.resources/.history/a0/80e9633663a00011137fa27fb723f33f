// 8비트 데이터를 MSB → LSB 순서로 직렬 전송
void send(uint8_t x)
{
	// 입력 데이터 x의 최상위 비트(MSB)를 확인하여
	// FND DIO 핀으로 HIGH(1) 또는 LOW(0) 출력
	//
	// 예) x = 0x46 = 0100 0110
	//     전송 순서: 0 → 1 → 0 → 0 → 0 → 1 → 1 → 0
	//     즉, MSB(7번 비트)부터 LSB(0번 비트) 순서로 전송
	for (int i = 8; i >= 1; i--)
	{
		// 0x80 = 1000 0000
		// x의 최상위 비트(MSB)가 1인지 확인
		if (x & 0x80)
		{
			// MSB가 1이면 DIO 핀을 HIGH로 출력
			HAL_GPIO_WritePin(PB14_FND_DIO_GPIO_Port, PB14_FND_DIO_Pin, 1);
		}
		else
		{
			// MSB가 0이면 DIO 핀을 LOW로 출력
			HAL_GPIO_WritePin(PB14_FND_DIO_GPIO_Port, PB14_FND_DIO_Pin, 0);
		}

		// 다음 비트를 전송하기 위해
		// x를 왼쪽으로 1비트 이동하여 다음 비트를 MSB 위치로 이동
		x <<= 1;

		// SCLK(Serial Clock) 클럭 생성
		// DIO에 데이터를 설정한 후 SCLK를 LOW → HIGH로 변화시켜
		// TM74HC595가 해당 데이터를 입력받도록 함
		// 시작 클럭은 HIGH. TM74HC595 데이터시트 참조
		HAL_GPIO_WritePin(PB15_FND_SCLK_GPIO_Port, PB15_FND_SCLK_Pin, 0);
		HAL_GPIO_WritePin(PB15_FND_SCLK_GPIO_Port, PB15_FND_SCLK_Pin, 1);
	}
}


// 데이터 x -> send(x) -> 포트 정보 -> send(port) -> RCLK (LOW → HIGH) -> 실제 출력 반영
void send_port(uint8_t x, uint8_t port)
{
	// 먼저 출력할 데이터 x를 8비트 직렬 데이터로 전송
	send(x);
	// 다음으로 데이터를 출력할 FND 포트 정보를 전송
	send(port);

	// RCLK(Latch/Storage Clock) 신호 생성
	// 앞에서 전송한 데이터와 포트 정보를 출력 레지스터에 반영
	//
	// LOW → HIGH 전환을 통해 TM74HC595의
	// Shift Register에 저장된 데이터를 출력으로 전달
	HAL_GPIO_WritePin(PB13_FND_RCLK_GPIO_Port, PB13_FND_RCLK_Pin, 0);
	HAL_GPIO_WritePin(PB13_FND_RCLK_GPIO_Port, PB13_FND_RCLK_Pin, 1);
}


void digit4(int n, int replay, uint8_t showZero)
{
	int n1, n2, n3, n4;

	n1 = (int) n % 10;
	n2 = (int) ((n % 100) - n1) / 10;
	n3 = (int) ((n % 1000) - n2 - n1) /100;
	n4 = (int) ((n % 10000) - n3 - n2 - n1) / 1000;

	for (int i = 0; i <= replay; i++)
	{
		// 1의 자리
		send_port(_LED_0F[n1], 0b0001);

		// 10의 자리
		if (showZero || n > 9)
			send_port(_LED_0F[n2], 0b0010);

		// 100의 자리
		if (showZero || n > 99)
			send_port(_LED_0F[n3], 0b0100);

		// 1000의 자리
		if (showZero || n > 999)
			send_port(_LED_0F[n4], 0b1000);
	}
}


void digit4_replay(int n, int replay)
{
	digit4(n, replay, 0);
}


void digit4_n(int n)
{
	digit4(n, 0, 0);
}


void digit4ShowZero_replay(int n, int replay)
{
	digit4(n, replay, 1);
}


void digit4ShowZero_n(int n)
{
	digit4(n, 0, 1);
}


void digit2(int n, int port, int replay)
{
	int n1, n2;
	n1 = (int) n % 10;
	n2 = (int) ((n % 100) - n1) / 10;

	for (int i = 0; i<= replay; i++)
	{
		send_port(_LED_0F[n1], port);
		send_port(_LED_0F[n2], port << 1);
	}
}


void digit2_port(int n, int port)
{
	digit2(n, port, 0);
}



